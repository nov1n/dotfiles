#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: $(basename "$0") <version> [--csv]"
  echo ""
  echo "  <version>  teamcity-dsl version prefix to check adoption for"
  echo "             e.g. '14.3.0' matches '14.3.0', '14.3.0-pr1079-...', etc."
  echo "  --csv      write a CSV file and print its path"
  exit 1
}

version=""
csv=false

for arg in "$@"; do
  case "$arg" in
    --csv) csv=true ;;
    --help | -h) usage ;;
    *) version="$arg" ;;
  esac
done

[[ -z "$version" ]] && usage

data=$(
  gh search code "teamcity-dsl" \
    --owner PicnicSupermarket \
    --filename ".teamcity/pom.xml" \
    --json repository,textMatches \
    --limit 500 \
    | jq '
      [.[] |
        .repository.nameWithOwner as $r |
        .textMatches[].fragment |
        match("<artifactId>teamcity-dsl</artifactId>\\s*<version>([^<]+)</version>") |
        {repo: $r, version: .captures[0].string}
      ]
      | unique_by(.repo)
      | sort_by(.version)
      | reverse
    '
)

total=$(echo "$data" | jq 'length')
adopted=$(echo "$data" | jq --arg v "$version" '[.[] | select(.version | startswith($v))] | length')
pct=$(awk "BEGIN { printf \"%d\", ($adopted / $total) * 100 }")

echo "${adopted}/${total} ${pct}%"

if [[ "$csv" == true ]]; then
  csv_file="teamcity-dsl-adoption-${version}.csv"
  echo "$data" | jq -r '["Repository","Version"], (.[] | [.repo, .version]) | @csv' >"$csv_file"
  echo "CSV: $csv_file"
fi
