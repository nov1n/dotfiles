#!/usr/bin/env bash

export PATH="/opt/homebrew/bin:$PATH"

function get_vpn_status() {
  local secureclient_bin
  for secureclient_bin in /opt/cisco/secureclient/bin/vpn /opt/cisco/anyconnect/bin/vpn; do
    if [[ -x "$secureclient_bin" ]]; then
      if "$secureclient_bin" -s state 2>/dev/null | grep -Eiq "state: Connected|>> state: Connected"; then
        return 0 # Connected
      else
        return 1 # Disconnected
      fi
    fi
  done

  # Fall back to picnic-cli if the Cisco client isn't found where expected.
  if picnic vpn 2>/dev/null | grep -Eiq "state: Connected|>> state: Connected"; then
    return 0 # Connected
  else
    return 1 # Disconnected
  fi
}

function flush_dns_cache() {
  echo "Skipping DNS cache flush."
  # echo "Flushing DNS cache..."
  # sudo dscacheutil -flushcache
  # sudo killall -HUP mDNSResponder
  # echo "DNS cache flushed."
}

function disconnect_vpn() {
  echo "Disconnecting VPN..."
  if picnic vpn disconnect; then
    echo "VPN disconnected successfully."
    flush_dns_cache
  else
    echo "Error disconnecting VPN or already disconnected."
  fi
}

function connect_vpn() {
  if get_vpn_status; then
    echo "VPN is already connected."
    flush_dns_cache
    return
  fi

  if picnic vpn connect; then
    echo "VPN connected successfully."
    flush_dns_cache
  else
    echo "Error connecting to VPN."
    return 1
  fi
}

function usage() {
  echo "Usage: $0 [connect|disconnect|toggle|status]"
  exit 1
}

ACTION="${1}"

case "$ACTION" in
  connect) connect_vpn ;;
  disconnect) disconnect_vpn ;;
  toggle)
    echo "Toggling VPN state..."
    if get_vpn_status; then disconnect_vpn; else connect_vpn; fi
    ;;
  status)
    if get_vpn_status; then
      echo "VPN is Connected."
      exit 0
    else
      echo "VPN is Disconnected."
      exit 1
    fi
    ;;
  *) usage ;;
esac

exit 0
